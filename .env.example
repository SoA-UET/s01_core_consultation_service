MONGO_URL=mongodb://localhost:27017/telcenter_core
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# S01 - Consultation Service
FLASK_SECRET_KEY=your-secret-key-here
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
S01_NUM_THREADS=4

# A02 - S02 AI Agent
A02_REQUEST_QUEUE=s01_s02_requests
A02_RESPONSE_QUEUE=s01_s02_responses

# A36 - S19 Conversation Analysis
A36A_QUEUE_NAME=s01_s19_events
A36B_QUEUE_NAME=s19_s01_events

# A35 - S18 Partner Selection
A35A_QUEUE_NAME=s01_s18_events
A35B_QUEUE_NAME=s18_s01_events

# A10 - S13 Partner Consultation
A10A_QUEUE_NAME=s01_s13_events
A10B_QUEUE_NAME=s13_s01_events

# A38 - S20 Speech Service
A38_REQUEST_QUEUE=s01_s20_requests
A38_RESPONSE_QUEUE=s01_s20_responses

# JWT Authentication
# URL of S04 Customer Identity Service
IDENTITY_SERVICE_URL=http://localhost:5004
# JWKS cache TTL in minutes (default: 10)
JWKS_TTL_IN_MINUTES=10

# New environment variables here as needed
